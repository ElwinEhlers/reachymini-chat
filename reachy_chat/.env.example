# Ollama (lokales LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b-q4km

# HuggingFace (für Emotion-Bibliothek und optionale Vision-Modelle)
HF_TOKEN=
HF_HOME=./cache

# Profil-Auswahl (leer lassen = eingebautes Standardprofil)
# REACHY_MINI_CUSTOM_PROFILE=mein_profil

# Optionale externe Verzeichnisse für Profile und Tools
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Alle Tools aus REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY automatisch laden,
# auch wenn sie nicht in tools.txt des aktiven Profils aufgeführt sind.
# AUTOLOAD_EXTERNAL_TOOLS=1
